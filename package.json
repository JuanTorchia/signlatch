{
  "name": "signlatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:start": "tsx scripts/run-dispatch-worker.ts",
    "completion:run": "tsx scripts/run-completion-worker.ts",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:contract": "tsx --test tests/foxit-esign-client.test.ts tests/foxit-webhook.test.ts",
    "test:attack": "tsx --test tests/approval-harness.test.ts tests/pdf-validation.test.ts tests/foxit-mcp-client.test.ts",
    "test:browser": "playwright test",
    "test:integration": "tsx --test --test-concurrency=1 tests-integration/**/*.test.ts",
    "test:harness": "tsx scripts/run-approval-harness.ts",
    "operator:live-proof": "tsx scripts/run-live-esign-proof.ts",
    "operations:restore-probe": "tsx scripts/run-restore-probe.ts",
    "evidence:verify": "tsx scripts/verify-evidence.ts",
    "evidence:privacy-scan": "tsx scripts/scan-evidence-privacy.ts",
    "evidence:links": "tsx scripts/verify-evidence-links.ts",
    "runtime:verify": "bash scripts/verify-runtime-boundary.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:integration": "pnpm check && pnpm test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5"
}
