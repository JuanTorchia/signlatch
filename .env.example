FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com/pdf-services
FOXIT_CLOUD_API_CLIENT_ID=
FOXIT_CLOUD_API_CLIENT_SECRET=
SIGNLATCH_DEMO_ENABLED=false
SIGNLATCH_ESIGN_ENQUEUE_ENABLED=false
SIGNLATCH_ESIGN_WORKER_ENABLED=false
SIGNLATCH_COMPLETION_WORKER_ENABLED=false
SIGNLATCH_COMPLETION_EVIDENCE_ENABLED=false
SIGNLATCH_PUBLIC_SHOWCASE_ENABLED=true
SIGNLATCH_LIVE_PREPARATION_DAILY_LIMIT=5
SIGNLATCH_LIVE_DISPATCH_GRANT_LIMIT=1
SIGNLATCH_LIVE_DISPATCH_GRANT_TTL_SECONDS=900
SIGNLATCH_JSON_BODY_LIMIT_BYTES=65536
SIGNLATCH_WEBHOOK_BODY_LIMIT_BYTES=1048576
SIGNLATCH_PDF_LIMIT_BYTES=10485760
SIGNLATCH_PARSER_OUTPUT_LIMIT_BYTES=262144
SIGNLATCH_CHILD_OUTPUT_LIMIT_BYTES=1048576
SIGNLATCH_PARSER_TIMEOUT_MS=10000
SIGNLATCH_MCP_TIMEOUT_MS=90000
SIGNLATCH_PROCESS_KILL_GRACE_MS=5000
SIGNLATCH_WORKER_LEASE_SECONDS=120
SIGNLATCH_WORKER_HEARTBEAT_SECONDS=30
FOXIT_ESIGN_BASE_URL=https://na1.fusion.foxit.com
FOXIT_ESIGN_ENVELOPE_PATH=/esign/api/v1/folders/createfolder
FOXIT_ESIGN_DETAILS_PATH=/esign/api/v1/folders/myfolder?folderId={envelopeId}
FOXIT_ESIGN_ACTIVITY_PATH=/esign/api/v1/folders/viewActivityHistory?folderId={envelopeId}
FOXIT_ESIGN_EXECUTED_DOCUMENT_PATH=/esign/api/v1/folders/download?folderId={envelopeId}
# Optional only when the account exposes a lookup supporting {idempotencyKey}.
FOXIT_ESIGN_CORRELATION_PATH=
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=
FOXIT_ESIGN_WEBHOOK_SECRET=
FOXIT_ESIGN_WEBHOOK_PREVIOUS_SECRET=
DATABASE_URL=
MIGRATION_DATABASE_URL=
SIGNLATCH_ARTIFACT_ROOT=
SIGNLATCH_PRIVATE_EVIDENCE_ROOT=
POSTGRES_PASSWORD=
# Production requires an absolute path such as /usr/local/bin/uv.
FOXIT_MCP_COMMAND=uv
# Absolute path to the official Python MCP server checkout or package directory.
FOXIT_MCP_CWD=
# SHA-256 of the approved executable file, lowercase hexadecimal.
FOXIT_MCP_COMMAND_SHA256=
# Absolute root containing the pinned official Foxit MCP module source.
FOXIT_MCP_MODULE_ROOT=
FOXIT_MCP_ALLOWED_ENV=FOXIT_CLOUD_API_HOST,FOXIT_CLOUD_API_CLIENT_ID,FOXIT_CLOUD_API_CLIENT_SECRET
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SESSION_SECRET=
SIGNLATCH_GITHUB_OPERATORS=
SIGNLATCH_MAINTAINER_TENANT_ID=
SIGNLATCH_PUBLIC_ORIGIN=https://signlatch.example.com
